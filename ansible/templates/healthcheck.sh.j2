#!/usr/bin/env bash
# Managed by Ansible - quick health check for {{ app_name }}
set -euo pipefail
URL="{{ health_url }}"
CODE=$(curl -s -o /tmp/{{ app_name }}-health.json -w '%{http_code}' "$URL" || true)
echo "Health: $URL -> HTTP $CODE"
cat /tmp/{{ app_name }}-health.json 2>/dev/null || true
echo
echo "Current release : $(cat {{ app_home }}/releases/current_tag 2>/dev/null || echo none)"
echo "Previous release: $(cat {{ app_home }}/releases/previous_tag 2>/dev/null || echo none)"
[ "$CODE" = "200" ]
